<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>WindowsIntelligence.Program</StartupObject>
    <Version>0.2.45</Version>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="WindowsIntelligence.Tests" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../XiaoAI.Protocol/XiaoAI.Protocol.csproj" /></ItemGroup>
  <ItemGroup><Content Include="Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="SpeechCpu.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.12.39" />
  </ItemGroup>
</Project>
